# Supabase project credentials (copy to apps/web/.env.local and fill in).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only — never import or reference in client components / browser bundles.
# Also used by Playwright experiment-session e2e to create a second user and
# verify RLS isolation (Node test process only — not the Next.js client bundle).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js only inlines NEXT_PUBLIC_* into the browser bundle.
# Set these to the same values as SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin for auth emails (password reset / confirm).
# Recovery emails always use this (or https://isitfr.vercel.app if unset).
NEXT_PUBLIC_SITE_URL=https://isitfr.vercel.app

# Hosted Supabase Dashboard → Authentication → URL configuration
# (https://supabase.com/dashboard/project/yzvjovpgsswjxfvqyfel/auth/url-configuration):
#   Site URL MUST be https://isitfr.vercel.app — not localhost.
#   Expired / invalid recovery links always redirect to Site URL.
#   Redirect URLs:
#     https://isitfr.vercel.app/**
#     http://localhost:3000/**
# Recovery email template must use {{ .ConfirmationURL }} (not {{ .SiteURL }}).
# Enable Email provider + Google OAuth provider for /login.
# Password recovery uses /auth/callback?next=/login/reset.

# Playwright auth-boundary e2e (`pnpm --filter web test:e2e`):
# a confirmed email/password user in this Supabase project.
E2E_EMAIL=e2e-user@example.com
E2E_PASSWORD=choose-a-strong-password

# AI (server-only — never NEXT_PUBLIC_). Used by:
#   POST /api/sessions/[id]/reflect
#   POST /api/crisis/personalize-template
# Groq Llama 3.3 70B via the Vercel AI SDK (GROQ_API_KEY) — free, no billing
# required, open-source models only.
# Production (Vercel): set the same server keys there — never prefix them
# with NEXT_PUBLIC_. Do not set E2E_* on Vercel.
GROQ_API_KEY=your-groq-api-key
